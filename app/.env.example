# Copy this file to .env and fill in your own values. Never commit .env.

# OpenRouter API key (server-side only, never exposed to the browser)
OPENROUTER_API_KEY=

# Model used for transcript analysis (any OpenRouter model with structured JSON output)
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Optional: reasoning effort sent to the model (leave empty to not send it). e.g. low, medium
LLM_REASONING_EFFORT=

# Limits
LLM_TIMEOUT_MS=90000
LLM_MAX_TOKENS=4000
MIN_TRANSCRIPT_CHARS=50
MAX_TRANSCRIPT_CHARS=60000

# Server
PORT=3000
DB_PATH=data/app.db

# Optional: sampling temperature (leave empty to not send it; many current models reject it)
LLM_TEMPERATURE=

# Network: the API listens on localhost only. Set HOST=0.0.0.0 to reach it from a phone
# on the same trusted network (the API has no login). For the Vite dev server use: LAN=1 npm run dev
HOST=127.0.0.1

# Voice messages: speech-to-text model on OpenRouter (Whisper), language and upload limit
STT_MODEL=openai/whisper-large-v3
STT_LANGUAGE=ru
MAX_AUDIO_MB=10
