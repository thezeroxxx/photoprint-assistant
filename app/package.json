{
  "name": "photoprint-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Photoprint AI Executive Assistant — checkpoint MVP (meeting transcript analysis)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --config client/vite.config.ts",
    "build": "npm run typecheck && tsc -p tsconfig.json && vite build --config client/vite.config.ts",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.tools.json && tsc -p client/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "compare": "tsx scripts/compare-models.ts",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "express": "5.3.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
